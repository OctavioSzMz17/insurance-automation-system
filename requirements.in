# requirements.in — abstract runtime dependencies for the entire monorepo.
#
# DO NOT pin versions here.  Exact pins + hashes live in requirements.txt,
# which is generated by:
#     scripts/security/compile_requirements.sh
# (re-run whenever you touch this file or bump a dep)
#
# The local shared package (-e ./packages/common) is installed separately
# in the Dockerfile BEFORE --require-hashes is applied (editable installs
# cannot carry a hash).

