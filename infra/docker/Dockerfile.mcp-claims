# ============================================================
# Claims MCP Server — Docker Image (C3.2)
# Multi-stage build to keep the final image lean.
#
# Rules applied:
#   Rule 7  — Runs as non-root user (uid 1000)
#   Rule 10 — Every MCP has its own Dockerfile
#   Rule 12 — Single root requirements.txt, installed in full
# ============================================================

# ── Stage 1: dependency builder ──────────────────────────────
FROM python:3.11.9-slim AS builder

WORKDIR /build

# psycopg2-binary needs gcc + libpq-dev to compile
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY packages/common ./packages/common

RUN pip install --upgrade pip --quiet \
 && pip install --prefix=/install --no-cache-dir -r requirements.txt --quiet

# ── Stage 2: runtime image ───────────────────────────────────
FROM python:3.11.9-slim AS runtime

WORKDIR /app

# Runtime lib needed by psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

COPY packages/common      ./packages/common
COPY mcp-servers/claims   ./mcp-servers/claims

RUN useradd --uid 1000 --no-create-home --shell /bin/false mcp
USER mcp

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

CMD ["python", "mcp-servers/claims/server.py"]
