# Shared base for all MCP server images.
#
# Hardening (Rule 10):
# - python:3.12-slim pinned to a digest (replace SHA when rebuilding).
# - Non-root user appuser (UID 1001).
# - Multi-stage: builder installs deps, runtime copies the venv only.
# - Read-only root filesystem is enforced at the K8s pod-spec level (not in this file)
#   with an emptyDir mount where Python needs to write (e.g. __pycache__ disabled).
#
# Each per-MCP Dockerfile extends this image, sets MCP_DOMAIN, and exposes the right port.

# ── Builder ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
COPY packages /build/packages

# Two-step install:
# 1. The local editable package cannot carry a hash → installed first, alone.
# 2. All third-party deps are installed with --require-hashes so every wheel
#    or sdist is verified against the hash recorded in requirements.txt.
#    requirements.txt is generated by scripts/security/compile_requirements.sh
#    on the target platform (linux/amd64, Python 3.12) — see that script for
#    regeneration instructions.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip==24.2 \
    && /opt/venv/bin/pip install --no-deps -e ./packages/common \
    && /opt/venv/bin/pip install --require-hashes --no-deps -r requirements.txt

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app:/app/mcp-servers"

RUN groupadd --system --gid 1001 app \
    && useradd  --system --uid 1001 --gid app --no-create-home --shell /usr/sbin/nologin appuser

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY --chown=appuser:app packages /app/packages
# observability/ holds the canonical logger and the tracer contract (Rule 9); every
# service imports it, so it belongs in the shared base rather than per-service images.
COPY --chown=appuser:app observability /app/observability
COPY --chown=appuser:app mcp-servers /app/mcp-servers
COPY --chown=appuser:app scripts /app/scripts
COPY --chown=appuser:app migrations /app/migrations
COPY --chown=appuser:app alembic.ini /app/alembic.ini

USER appuser

# No CMD here — per-MCP Dockerfile sets it.
