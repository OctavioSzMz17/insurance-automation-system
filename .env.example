# ============================================================
# Environment Configuration — Insurance Automation System
# Copy to .env and fill in actual values
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/insurance_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=insurance_user
DB_PASSWORD=changeme
DB_NAME=insurance_db

# API & Server
API_HOST=0.0.0.0
API_PORT=8000
ORCHESTRATOR_PORT=8000
MCP_SERVER_PORT=8001

# JWT & Security
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM & AI
ANTHROPIC_API_KEY=sk-ant-xxxxx
MODEL_NAME=claude-opus-4-7
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insurance-automation
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO

# MCP Servers (service discovery)
MCP_CLAIMS_URL=http://localhost:8002
MCP_POLICIES_URL=http://localhost:8003
MCP_USERS_URL=http://localhost:8004
MCP_DOCUMENTS_URL=http://localhost:8005

# PDF Processing
PDF_MAX_SIZE_MB=50
PDF_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
OCR_ENABLED=true

# Agent Configuration
ANALYST_AGENT_TIMEOUT_SECONDS=30
AUDITOR_AGENT_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3
MANUAL_REVIEW_ESCALATION_ENABLED=true

# Environment
ENVIRONMENT=development
DEBUG=true

# External Services (future)
STRIPE_API_KEY=
SENDGRID_API_KEY=
