# =============================================================================
# .env.example — committed; .env is the gitignored real file used at runtime.
# Copy this to .env and fill in real values. Never commit the real .env.
# =============================================================================

# Deployment context. Values in {production, prod, staging} activate stricter
# validations: JWT_SECRET_KEY ≥ 32 chars and not the placeholder, LANGFUSE key
# not all zeros, CLAIM_UPLOAD_DIR not under /tmp, dev token issuance disabled.
ENVIRONMENT=development

# Log verbosity. Production uses INFO; raise to DEBUG only in non-prod.
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Admin URL — used only by Alembic migrations and the seed script. Never given
# to MCP containers in production.
DATABASE_URL=postgresql://insurance:insurance_local_password@localhost:5432/insurance

# Per-MCP least-privilege URLs (migration 0003 creates these roles).
# Passwords shown here are the dev defaults from the migration — CHANGE THEM
# before deploying to staging/production.
DATABASE_URL_CLAIMS=postgresql://mcp_claims:mcp_claims_dev_password@localhost:5432/insurance
DATABASE_URL_POLICIES=postgresql://mcp_policies:mcp_policies_dev_password@localhost:5432/insurance
DATABASE_URL_USERS=postgresql://mcp_users:mcp_users_dev_password@localhost:5432/insurance
# documents MCP is filesystem-only — it uses DATABASE_URL only as a fallback
# health-check; no table access is required.
DATABASE_URL_DOCUMENTS=${DATABASE_URL}

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MCP transport secret ─────────────────────────────────────────────────────
# Must be ≥ 32 characters. Production target is mTLS; static secret is dev-only.
MCP_SHARED_SECRET=replace-me-with-a-strong-secret-at-least-32-chars

# ── Documents MCP ────────────────────────────────────────────────────────────
# Filesystem path where uploaded PDFs live. Never /tmp in production.
CLAIM_UPLOAD_DIR=./data/uploads

# ── Orchestrator / analyst_agent (Phase 2) ───────────────────────────────────
# Tier definitions: provider:model_id. Pick the tier the analyst uses.
LOW_MODEL=anthropic:claude-haiku-4-5
MEDIUM_MODEL=anthropic:claude-sonnet-4-6
HIGH_MODEL=anthropic:claude-opus-4-7
ANALYST_MODEL_TIER=medium

# Provider API keys — only the provider you actually wire needs its key.
ANTHROPIC_API_KEY=replace-with-real-key
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_BASE_URL=             # e.g. http://localhost:11434/v1 for Ollama, or LM Studio
LOCAL_API_KEY=              # most local servers ignore this; set anything

MCP_CLAIMS_URL=http://localhost:8001
MCP_POLICIES_URL=http://localhost:8002
MCP_USERS_URL=http://localhost:8003
MCP_DOCUMENTS_URL=http://localhost:8004
# HMAC key for ClaimProposal — MUST be ≥ 32 chars and DIFFERENT from MCP_SHARED_SECRET.
HMAC_PROPOSAL_KEY=replace-with-a-strong-secret-at-least-32-chars
ANALYST_MAX_STEPS=10
ANALYST_TIMEOUT_SECONDS=60
ANALYST_PROPOSAL_TTL_SECONDS=300

# ── JWT / Auth (Phase 4) ─────────────────────────────────────────────────────
# HS256 key — must be ≥ 32 chars and NOT the default in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-replace-me-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
# Optional aud/iss claims — bind tokens to this service in production.
JWT_AUDIENCE=
JWT_ISSUER=

# ── CORS (Phase 4) ────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Never use * in production.
# Example: CORS_ALLOWED_ORIGINS=https://app.myinsurance.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Rate limiting (Phase 4) ──────────────────────────────────────────────────
# Sliding window per authenticated user (JWT sub) or IP.
# Recommended production values: 10 requests per 60 seconds.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observability (Rule 9) ───────────────────────────────────────────────────
# Tracing backends, comma-separated. `noop` costs nothing; `log` writes one
# structured JSON line per span and needs no infrastructure. Composing is the point:
# `log,langfuse` keeps local visibility while shipping to the trace store.
#   noop | log | recording | langfuse        (eventbus arrives with the live UI)
OBSERVABILITY_BACKEND=log
# Redaction applied before any span leaves the process: none | pii | strict.
# Leave empty to decide from ENVIRONMENT — `pii` in production/staging, `none`
# in development. Document text is summarised at every level, never sent whole.
OBSERVABILITY_MASK=

# ── Langfuse (only needed when OBSERVABILITY_BACKEND includes `langfuse`) ────
# Read directly by the Langfuse SDK. In production the orchestrator refuses to
# start if the backend is enabled and these are missing — a service must never
# run believing it is traced when it is not.
# Self-hosting setup: infra/observability/README.md
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted: http://localhost:3000. Leave empty for Langfuse Cloud.
LANGFUSE_BASE_URL=http://localhost:3000

# ── Langfuse server secrets — SELF-HOSTED ONLY ───────────────────────────────
# Consumed by the Langfuse containers, never by this service. Kept here because
# they live in the same .env and are validated at startup (Rule 8).
# Generate with: openssl rand -hex 32   (must be 64 hex chars, never 64 zeros)
LANGFUSE_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=

# ── mTLS — orchestrator client cert (F4.7) ───────────────────────────────────
# Leave empty to run plain HTTP (default for local dev).
# Generate certs with: bash scripts/certs/gen_dev_certs.sh
# When set, also change MCP_*_URL above from http:// to https://
MCP_CLIENT_CERT=
MCP_CLIENT_KEY=
MCP_CA_CERT=

# ── mTLS — MCP server certs (set per container in docker-compose or K8s) ─────
# These are consumed by entrypoint_mcp.sh inside the MCP containers.
# Leave empty to serve plain HTTP.
MCP_TLS_CERT=
MCP_TLS_KEY=
# MCP_CA_CERT is shared above (same CA for both client and server verification).
